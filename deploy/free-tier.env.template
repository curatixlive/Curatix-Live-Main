# ═══════════════════════════════════════════════════════════════════════════
# FREE-TIER TEST DEPLOYMENT — environment for ONE Render free Web Service
# ═══════════════════════════════════════════════════════════════════════════
# Names only. NEVER commit real values. In Render: Environment -> "Add from
# .env" and paste this block with your own values filled in.
#
# Lines with a value already are fixed choices for this topology; fill in every
# line that ends in `=` (blank). Production preflight refuses to boot if a
# needed one is blank, and the error names the variable.
# ═══════════════════════════════════════════════════════════════════════════

# ── Fixed ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
ENVIRONMENT=production
DEBUG=false
CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=true
NUM_PROXIES=1
WEB_CONCURRENCY=1
PAYMENTS_BACKEND=razorpay
PAYMENTS_ENABLED_GATEWAYS=cashfree,razorpay
PAYMENTS_DEFAULT_GATEWAY=cashfree
PAYMENTS_ROUTE_PROVIDER=razorpay
CASHFREE_ENVIRONMENT=sandbox
CACHE_BACKEND=redis
STORAGE_BACKEND=s3
S3_REGION=ap-south-1
EMAIL_PROVIDER=smtp
SMTP_PORT=587
SMS_PROVIDER=disabled
# WhatsApp Business (Meta Cloud API). See WHATSAPP_SETUP.md.
# disabled = not connected yet (messages skipped, email still goes);
# console = dev fake that logs; meta = real (needs the two values below).
WHATSAPP_PROVIDER=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_NAMES=
QUEUE_BACKEND=local
EVENT_BUS_BACKEND=inprocess

# ── Secrets YOU generate (each 32+ chars; `openssl rand -base64 48`) ────────
SECRET_KEY=
JWT_SIGNING_KEY=
TICKET_QR_SIGNING_KEY=
# Also put this same value in GitHub -> Settings -> Secrets -> INTERNAL_TASK_SECRET
INTERNAL_TASK_SECRET=

# ── Neon (Dashboard -> Connect) ─────────────────────────────────────────────
# Pooled URL = host contains "-pooler".  Direct URL = same without "-pooler".
DATABASE_URL=
DIRECT_DATABASE_URL=

# ── Upstash Redis (rediss:// URL, no ssl_cert_reqs param) ───────────────────
REDIS_URL=

# ── Cashfree (sandbox pair) and Razorpay (test keys) ────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Supabase Storage (S3 connection) ────────────────────────────────────────
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL objects are served from (the bucket's public URL prefix).
S3_PUBLIC_BASE_URL=

# ── Brevo SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── Your URLs (fill after the first Render + Vercel deploys) ────────────────
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
FRONTEND_BASE_URL=
PUBLIC_SITE_URL=
# This API's public address, for outside services to fetch from (WhatsApp ticket QR).
PUBLIC_API_URL=https://curatix.onrender.com/api/v1
